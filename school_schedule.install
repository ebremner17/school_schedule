<?php

/**
 * Implements hook_schema().
 */
function school_schedule_schema() {
  $schema['school_schedule_months'] = [
    'description' => 'Months configured to display on the school schedule calendars (shared by both children).',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE, 'unsigned' => TRUE],
      'year' => ['type' => 'int', 'not null' => TRUE],
      'month' => ['type' => 'int', 'not null' => TRUE, 'description' => '1-12'],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'year_month' => ['year', 'month'],
    ],
  ];

  $schema['school_schedule_days'] = [
    'description' => 'Per-child, per-day manual school schedule entries.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE, 'unsigned' => TRUE],
      'child' => ['type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'description' => 'finnley|amelia'],
      'day_date' => ['type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'description' => 'YYYY-MM-DD'],
      'is_school_day' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'am_option' => ['type' => 'varchar', 'length' => 20, 'null' => TRUE, 'description' => 'bus|dropoff|late_arrival'],
      'pm_option' => ['type' => 'varchar', 'length' => 20, 'null' => TRUE, 'description' => 'bus|pickup|early_pickup'],
      'parent' => ['type' => 'varchar', 'length' => 10, 'null' => TRUE, 'description' => 'eric|sarah, the responsible parent for the day'],
      'late_arrival_parent' => ['type' => 'varchar', 'length' => 10, 'null' => TRUE, 'description' => 'eric|sarah, set when am_option is late_arrival'],
      'early_pickup_parent' => ['type' => 'varchar', 'length' => 10, 'null' => TRUE, 'description' => 'eric|sarah, set when pm_option is early_pickup'],
      'occasion_text' => ['type' => 'varchar', 'length' => 100, 'null' => TRUE, 'description' => 'Free text shown on non-school days, e.g. PA Day, Thanksgiving.'],
      'description' => ['type' => 'varchar', 'length' => 100, 'null' => TRUE, 'description' => 'Optional free text on a school day, e.g. Speech Therapy.'],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'child_day_date' => ['child', 'day_date'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function school_schedule_install() {
  $database = \Drupal::database();
  $months = [
    [2026, 9], [2026, 10], [2026, 11], [2026, 12],
    [2027, 1], [2027, 2], [2027, 3],
  ];
  foreach ($months as [$year, $month]) {
    $database->merge('school_schedule_months')
      ->keys(['year' => $year, 'month' => $month])
      ->execute();
  }
}

/**
 * Add the "description" column (free text on a school day, e.g. Speech
 * Therapy) to school_schedule_days.
 */
function school_schedule_update_9001(&$sandbox) {
  $schema = \Drupal::database()->schema();

  if (!$schema->fieldExists('school_schedule_days', 'description')) {
    $schema->addField('school_schedule_days', 'description', [
      'type' => 'varchar',
      'length' => 100,
      'null' => TRUE,
      'description' => 'Optional free text on a school day, e.g. Speech Therapy.',
    ]);
  }

  return t('Added the description column to school_schedule_days.');
}

/**
 * Replace the generic "parent" column with "late_arrival_parent" and
 * "early_pickup_parent", each only meaningful when the matching AM/PM
 * option is selected.
 */
function school_schedule_update_9002(&$sandbox) {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->fieldExists('school_schedule_days', 'late_arrival_parent')) {
    $schema->addField('school_schedule_days', 'late_arrival_parent', [
      'type' => 'varchar',
      'length' => 10,
      'null' => TRUE,
      'description' => 'eric|sarah, set when am_option is late_arrival',
    ]);
  }
  if (!$schema->fieldExists('school_schedule_days', 'early_pickup_parent')) {
    $schema->addField('school_schedule_days', 'early_pickup_parent', [
      'type' => 'varchar',
      'length' => 10,
      'null' => TRUE,
      'description' => 'eric|sarah, set when pm_option is early_pickup',
    ]);
  }

  if ($schema->fieldExists('school_schedule_days', 'parent')) {
    $database->update('school_schedule_days')
      ->expression('late_arrival_parent', 'parent')
      ->condition('am_option', 'late_arrival')
      ->execute();
    $database->update('school_schedule_days')
      ->expression('early_pickup_parent', 'parent')
      ->condition('pm_option', 'early_pickup')
      ->execute();
    $schema->dropField('school_schedule_days', 'parent');
  }

  return t('Replaced the parent column with late_arrival_parent and early_pickup_parent.');
}

/**
 * Re-add the "parent" column (the responsible parent for the whole school
 * day) alongside late_arrival_parent and early_pickup_parent.
 */
function school_schedule_update_9003(&$sandbox) {
  $schema = \Drupal::database()->schema();

  if (!$schema->fieldExists('school_schedule_days', 'parent')) {
    $schema->addField('school_schedule_days', 'parent', [
      'type' => 'varchar',
      'length' => 10,
      'null' => TRUE,
      'description' => 'eric|sarah, the responsible parent for the day',
    ]);
  }

  return t('Re-added the parent column to school_schedule_days.');
}
